//! Test suite for `<<MODULE_NAME>>` (auto-generated by zmodu).
//! Extend with domain-specific tests. Survives regeneration.
//!
//! Both tests run against in-memory SQLite via `http.Testkit` — no server
//! listening, no fixture files, and `dispatch` drives the generated route
//! through the real router/handler/service stack.
//!
//! The file is a module test root: wire it into the project's test root
//! (`src/tests.zig`) with
//!     test { _ = @import("modules/<<MODULE_NAME>>/test.zig"); }
//! or point a `zig build test` step at it directly.

const std = @import("std");
const zigmodu = @import("zigmodu");
const http = zigmodu.http;

const model = @import("model.zig");
const persistence = @import("persistence.zig");
const service = @import("service.zig");
const api = @import("api.zig");

const Row = model.<<MODEL_NAME>>;
const Service = service.<<PASCAL_MODULE>>Service;
const Api = api.<<PASCAL_MODULE>>Api;

/// The scaffold emits no migrations, so the test builds the table its model
/// describes: one column per struct field, `id` as the primary key.
fn createTableSql(allocator: std.mem.Allocator, comptime T: type) ![]u8 {
    var buf: std.ArrayList(u8) = .empty;
    errdefer buf.deinit(allocator);
    try buf.appendSlice(allocator, "CREATE TABLE IF NOT EXISTS ");
    try buf.appendSlice(allocator, T.sql_table_name);
    try buf.appendSlice(allocator, " (id INTEGER PRIMARY KEY AUTOINCREMENT");
    inline for (@typeInfo(T).@"struct".field_names, @typeInfo(T).@"struct".field_types) |name, FieldType| {
        if (comptime !std.mem.eql(u8, name, "id")) {
            try buf.print(allocator, ", {s} {s}", .{ name, columnType(FieldType) });
        }
    }
    try buf.append(allocator, ')');
    return buf.toOwnedSlice(allocator);
}

fn columnType(comptime T: type) []const u8 {
    return switch (@typeInfo(T)) {
        .int, .bool => "INTEGER",
        .float => "REAL",
        .pointer => "TEXT",
        .optional => columnType(@typeInfo(T).optional.child),
        else => @compileError("unsupported column type: " ++ @typeName(T)),
    };
}

/// A row with every field filled in: optional fields stay null (the database
/// assigns them), string fields carry a value because the generated
/// `validate` hook rejects empty ones.
fn sampleRow() Row {
    var row: Row = undefined;
    inline for (@typeInfo(Row).@"struct".field_names, @typeInfo(Row).@"struct".field_types) |name, FieldType| {
        @field(row, name) = switch (@typeInfo(FieldType)) {
            .int => 0,
            .float => 0,
            .bool => false,
            .pointer => "zmodu",
            .optional => null,
            else => @compileError("unsupported field type: " ++ @typeName(FieldType)),
        };
    }
    return row;
}

/// `:memory:` is per-connection, so pin the pool to the connection that holds
/// the schema — a second pooled connection would see an empty database.
fn openTestDb(allocator: std.mem.Allocator, io: std.Io, comptime T: type) !zigmodu.data.sqlx.Client {
    var client = try http.Testkit.openMemorySqlite(allocator, io);
    errdefer client.deinit();
    client.config.max_open_conns = 1;
    client.config.max_idle_conns = 1;

    const ddl = try createTableSql(allocator, T);
    defer allocator.free(ddl);
    _ = try client.exec(ddl, &.{});
    return client;
}

/// `/api` + the api type's own `nest` segments + `routes[index].path` — the
/// path comes from the generated route table, never from a literal here.
fn routePath(buf: []u8, comptime index: usize) ![]const u8 {
    var written = (try std.fmt.bufPrint(buf, "/api", .{})).len;
    inline for (Api.nest) |segment| {
        written += (try std.fmt.bufPrint(buf[written..], "/{s}", .{segment})).len;
    }
    written += (try std.fmt.bufPrint(buf[written..], "/{s}", .{Api.routes[index].path})).len;
    return buf[0..written];
}

/// Index of the first route with `method` — keeps the test attached to the
/// route table instead of a positional literal.
fn routeIndex(comptime method: http.Method) usize {
    inline for (Api.routes, 0..) |route, index| {
        if (route.method == method) return index;
    }
    @compileError(@tagName(method) ++ " route missing from " ++ @typeName(Api));
}

test "<<MODULE_NAME>>: repository insert / findById round-trip" {
    const allocator = std.testing.allocator;

    var client = try openTestDb(allocator, std.testing.io, Row);
    defer client.deinit();

    const backend = zigmodu.data.SqlxBackend{ .allocator = allocator, .client = &client };
    var store = persistence.<<PASCAL_MODULE>>Persistence.init(backend);
    var svc = Service.init(&store);

    const created = try svc.create<<MODEL_NAME>>(sampleRow());
    const id = created.id orelse return error.MissingGeneratedId;
    try std.testing.expect(id > 0);

    const fetched = (try svc.get<<MODEL_NAME>>(id)) orelse return error.RowNotFound;
    // `findById` hands back an owned row (strings included) — release it with
    // the framework helper, exactly like a production handler must.
    defer zigmodu.data.sqlx.freeScanned(allocator, Row, fetched);
    inline for (@typeInfo(Row).@"struct".field_names, @typeInfo(Row).@"struct".field_types) |name, FieldType| {
        if (FieldType == []const u8) {
            try std.testing.expectEqualStrings(@field(created, name), @field(fetched, name));
        }
    }

    try svc.delete<<MODEL_NAME>>(id);
    try std.testing.expect((try svc.get<<MODEL_NAME>>(id)) == null);
}

test "<<MODULE_NAME>>: the POST create route answers through http.Testkit.dispatch" {
    const allocator = std.testing.allocator;
    const io = std.testing.io;

    var client = try openTestDb(allocator, io, Row);
    defer client.deinit();

    const backend = zigmodu.data.SqlxBackend{ .allocator = allocator, .client = &client };
    var store = persistence.<<PASCAL_MODULE>>Persistence.init(backend);
    var svc = Service.init(&store);

    var state = Api.init(&svc);

    // The generated handlers take request-scoped values from `ctx.allocator`
    // (== the server allocator) and never hand them back, so the server runs on
    // an arena: `std.testing.allocator` then reports only leaks this test
    // itself caused. Drop the arena once the handlers release their values.
    var arena_state = std.heap.ArenaAllocator.init(allocator);
    defer arena_state.deinit();
    const arena = arena_state.allocator();

    var server = http.Server.init(io, arena, 0);
    defer server.deinit();

    const AppState = struct {};
    var app_state: AppState = .{};
    var router = http.Router(AppState).init(io, allocator, &server, &app_state);
    defer router.deinit();
    var scope = router.scope("/api");
    try scope.mount(Api, &state);

    const body = try std.json.Stringify.valueAlloc(allocator, sampleRow(), .{});
    defer allocator.free(body);

    var path_buf: [256]u8 = undefined;
    const create_path = try routePath(&path_buf, comptime routeIndex(.POST));

    var resp = try http.Testkit.dispatch<<POST_DISPATCH>>;
    defer resp.deinit(arena);

    try std.testing.expectEqual(@as(u16, 200), resp.status_code);
    try std.testing.expect(std.mem.indexOf(u8, resp.body, "\"code\":0") != null);
    try std.testing.expect(std.mem.indexOf(u8, resp.body, "\"id\":1") != null);

    // The row really landed: a second request over the same database sees it.
    const stored = (try svc.get<<MODEL_NAME>>(1)) orelse return error.RowNotFound;
    defer zigmodu.data.sqlx.freeScanned(allocator, Row, stored);

    // A path outside the route table still 404s — the assertions above are
    // reading a real match, not a catch-all.
    var missing = try http.Testkit.dispatch(&server, .GET, "/api/nope", null);
    defer missing.deinit(arena);
    try std.testing.expectEqual(@as(u16, 404), missing.status_code);
}
