# The gateway in front of the smuggling probe, in the shape this repo ships in
# examples/production-deploy/nginx.conf (TLS terminated at the edge, h2c/HTTP
# upstreams, keepalive to the backend).
#
# Two listeners, because the framing decision a gateway makes depends on whether
# it buffers the request body:
#
#   :18081  proxy_request_buffering on  (nginx's default) — the body is consumed
#           here per nginx's own framing and one clean request is forwarded.
#   :18082  proxy_request_buffering off — the body is streamed upstream and the
#           chunked framing is preserved, which is the shape that puts a
#           `Transfer-Encoding` in front of a `Content-Length`-only backend.
#
# `log_format smug` prints only `METHOD URI` so the harness can diff what the
# gateway forwarded against what the backend says it served. A request the
# backend served but the gateway never forwarded **is** a smuggling primitive,
# by definition — that comparison, not the raw response bytes, is the assertion.
#
# `@APP_PORT@` is substituted by `run.sh` into a rendered copy under its temp
# dir and *that* is what gets mounted. Deliberately not `${APP_PORT}`: nginx
# does not expand environment variables, and the official image's
# `envsubst-on-templates` only reaches `/etc/nginx/templates` — a conf mounted
# at `conf.d/` is used verbatim. Hardcoding the port here is what made the first
# CI run fail with `connect() failed (111: Connection refused)` to
# `172.17.0.1:18080` while the probe was listening on 18180.

log_format smug '$request_method $request_uri';

server {
    listen 18081;
    access_log /dev/stdout smug;

    location / {
        proxy_pass http://host.docker.internal:@APP_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_read_timeout 5s;
    }
}

server {
    listen 18082;
    access_log /dev/stdout smug;

    location / {
        proxy_pass http://host.docker.internal:@APP_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 5s;
    }
}
